# Azure OpenAI - writes the script
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2024-10-21
# reasoning models stall before the first token - 'none' keeps the story fast
AZURE_OPENAI_REASONING_EFFORT=none

# Azure AI Speech - speech-to-text, plus gpt-4o-mini-tts for the character voices
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
